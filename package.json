{
  "name": "larry",
  "version": "0.1.0",
  "private": true,
  "description": "Larry: Fantasy Basketball Command Center",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:engine": "esbuild src/engine/index.ts --bundle --format=iife --global-name=LarryEngine --outfile=dist/larry-engine.js --target=es2020 --sourcemap",
    "build": "npm run build:engine"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
